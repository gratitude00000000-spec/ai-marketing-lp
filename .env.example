# ============================================================
#  AI集客ドットコム — 環境変数テンプレート
#  実際の値は .env.local に設定する（.env.local は Git 管理外）
#  ※ 実キー・実IDをこのファイルやコードに書かないこと
# ============================================================

# --- サイト基本情報 ---
NEXT_PUBLIC_SITE_URL=https://ai-marketing-japan.jp
NEXT_PUBLIC_SITE_NAME=AI集客ドットコム

# --- microCMS（サーバーサイド専用 / NEXT_PUBLIC_ を付けない）---
# 管理画面 > API設定 で確認。APIキーはローテーション後の新しいものを入れる。
MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-new-api-key
# 記事エンドポイント名（既定: blogs）
MICROCMS_BLOG_ENDPOINT=blogs

# --- アナリティクス（任意 / 未設定なら計測タグは出力されない）---
NEXT_PUBLIC_GA4_ID=

# --- Search Console（任意）---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
